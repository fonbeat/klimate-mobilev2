{
  "name": "klimate-mobile",
  "version": "2026.10.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "audit:security": "pnpm audit --prod --audit-level=high",
    "version:next": "node scripts/calendar-version.cjs",
    "doctor": "expo-doctor",
    "check:store": "node --env-file-if-exists=.env scripts/check-store-readiness.cjs",
    "eas-build-post-install": "node scripts/eas-release-check.cjs",
    "test": "node --no-warnings --test src/*.test.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
